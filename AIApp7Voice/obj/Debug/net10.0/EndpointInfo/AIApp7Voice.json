{
  "openapi": "3.0.4",
  "info": {
    "title": "AIApp7 - Voice AI Pipeline",
    "description": "Speak → AI listens → AI thinks → AI speaks back. Built with Whisper + GPT-4o-mini + OpenAI TTS + .NET 8",
    "version": "v1"
  },
  "paths": {
    "/": {
      "get": {
        "tags": [
          "AIApp7Voice"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Voice/transcribe": {
      "post": {
        "tags": [
          "Voice"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio": {
                    "type": "string",
                    "format": "binary"
                  }
                }
              },
              "encoding": {
                "audio": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Voice/speak": {
      "post": {
        "tags": [
          "Voice"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceSpeakRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceSpeakRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/VoiceSpeakRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Voice/ask": {
      "post": {
        "tags": [
          "Voice"
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "audio": {
                    "type": "string",
                    "format": "binary"
                  },
                  "voice": {
                    "type": "string",
                    "default": "nova"
                  }
                }
              },
              "encoding": {
                "audio": {
                  "style": "form"
                },
                "voice": {
                  "style": "form"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Voice/voices": {
      "get": {
        "tags": [
          "Voice"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/api/Voice/health": {
      "get": {
        "tags": [
          "Voice"
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "VoiceSpeakRequest": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "nullable": true
          },
          "voice": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "AIApp7Voice"
    },
    {
      "name": "Voice"
    }
  ]
}